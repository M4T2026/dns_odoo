<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="dns_pos_promotions.Workspace" owl="1">
<main class="dns-app">
  <button t-if="state.mobileNavOpen" class="dns-nav-scrim" aria-label="Close navigation" t-on-click="toggleMobileNav"/>
  <aside t-att-class="'dns-sidebar ' + (state.mobileNavOpen ? 'open' : '')">
    <div class="dns-logo"><b>Odoo</b><span>PROMOTIONS</span><small>RETAIL COMMAND</small></div>
    <nav>
      <button t-att-class="state.view === 'dashboard' ? 'active' : ''" t-on-click="() => this.navigate('dashboard')"><i class="fa fa-th-large"/>Dashboard</button>
      <button t-att-class="state.view === 'promotions' ? 'active' : ''" t-on-click="() => this.navigate('promotions')"><i class="fa fa-bullhorn"/>Promotions</button>
      <button t-if="canBuild" t-att-class="state.view === 'builder' ? 'active' : ''" t-on-click="startBuilder"><i class="fa fa-plus-square"/>Promotion builder</button>
      <button t-if="isManager" t-att-class="state.view === 'stores' ? 'active' : ''" t-on-click="() => this.navigate('stores')"><i class="fa fa-building"/>Store groups</button>
      <button t-att-class="state.view === 'selectors' ? 'active' : ''" t-on-click="() => this.navigate('selectors')"><i class="fa fa-filter"/>Product selectors</button>
      <button t-att-class="state.view === 'products' ? 'active' : ''" t-on-click="() => this.navigate('products')"><i class="fa fa-barcode"/>Product explorer</button>
      <button t-att-class="state.view === 'conflicts' ? 'active' : ''" t-on-click="() => this.navigate('conflicts')"><i class="fa fa-exclamation-triangle"/>Conflict queue <em t-esc="state.dashboard.counts.conflict || 0"/></button>
      <!-- Leaves the workspace for the backend pivot: the standalone webapp hides the Odoo
           navbar, so the Analysis menu cannot be reached from in here otherwise. -->
      <button t-if="isManager" t-on-click="openAnalysis"><i class="fa fa-bar-chart"/>Analysis</button>
    </nav>
    <button t-if="canBuild" class="dns-create" t-on-click="startBuilder"><i class="fa fa-plus"/> Create promotion</button>
  </aside>
  <section class="dns-main">
    <header class="dns-topbar">
      <button class="dns-mobile-menu" aria-label="Open navigation" t-on-click="toggleMobileNav"><i class="fa fa-bars"/></button>
      <button t-if="state.view !== 'dashboard'" class="dns-app-back" aria-label="Go back" t-on-click="goBack"><i class="fa fa-arrow-left"/><span>Back</span></button>
      <div><span class="dns-kicker">ODOO</span><h1 t-esc="state.view === 'builder' ? 'Promotion Builder' : state.view.replaceAll('_',' ')"/></div>
      <label class="dns-search"><i class="fa fa-search"/><input t-model="state.query" t-on-keydown="onSearchKeydown" placeholder="Search promotion, SKU or scan barcode"/></label>
      <button class="dns-help" aria-label="Help"><i class="fa fa-question-circle"/></button>
    </header>
    <div class="dns-content">
      <div t-if="state.loading" class="dns-loading"><i class="fa fa-circle-o-notch fa-spin"/> Loading retail data…</div>

      <t t-if="state.view === 'dashboard'">
        <section class="dns-hero"><div><span>RETAIL PROMOTION CONTROL</span><h2>Every offer. Every store.<br/>One clear workspace.</h2><p>Designed for high-volume campaigns without product-by-product setup.</p></div><button t-if="canBuild" t-on-click="startBuilder">BUILD A PROMOTION <i class="fa fa-arrow-right"/></button></section>
        <section class="dns-metrics">
          <button t-on-click="() => this.applyState('active')"><span>ACTIVE</span><b t-esc="state.dashboard.counts.active || 0"/><small>Live at POS</small></button>
          <button class="blue" t-on-click="() => this.applyState('scheduled')"><span>UPCOMING</span><b t-esc="state.dashboard.counts.scheduled || 0"/><small>Ready to launch</small></button>
          <button class="red" t-on-click="() => this.applyState('conflict')"><span>CONFLICTS</span><b t-esc="state.dashboard.counts.conflict || 0"/><small>Action required</small></button>
          <button t-on-click="() => this.applyState('ending_soon')"><span>ENDING SOON</span><b t-esc="state.dashboard.counts.ending_soon || 0"/><small>Next 7 days</small></button>
        </section>
        <section class="dns-two-col"><article class="dns-panel"><header><h3>RECENT PROMOTIONS</h3><button t-on-click="() => this.navigate('promotions')">VIEW ALL →</button></header><div class="dns-mini dns-row-open" t-foreach="state.promotions.slice(0,6)" t-as="promo" t-key="promo.id" t-on-click="() => this.openPromotion(promo.id)"><button t-esc="promo.name"/><span t-att-class="'dns-badge '+promo.state" t-esc="stateLabel(promo.state)"/><b><t t-esc="promo.product_count"/> SKUs · <t t-esc="promo.warehouse_count"/> stores</b></div></article><article class="dns-panel dns-actions"><header><h3>QUICK ACTIONS</h3></header><button t-if="canBuild" t-on-click="startBuilder"><i class="fa fa-plus"/>Create new promotion</button><button t-on-click="() => this.navigate('products')"><i class="fa fa-barcode"/>Find by barcode</button><button t-on-click="() => this.navigate('conflicts')"><i class="fa fa-check-square-o"/>Review conflicts</button></article></section>
      </t>

      <t t-if="state.view === 'promotions'">
        <section class="dns-page-head"><div><h2>Promotion Library</h2><p><t t-esc="state.total"/> campaigns across the retail network</p></div><button t-if="canBuild" class="dns-primary" t-on-click="startBuilder">+ NEW PROMOTION</button></section>
        <div class="dns-toolbar"><select t-model="state.status" t-on-change="load"><option value="">All states</option><option value="draft">Draft</option><option value="conflict">Conflict</option><option value="scheduled">Scheduled</option><option value="active">Active</option><option value="ending_soon">Ending in 7 days</option><option value="ended">Ended</option></select><button t-if="isManager and state.selected.size" t-on-click="bulkArchive">Archive selected (<t t-esc="state.selected.size"/>)</button></div>
        <div class="dns-table-wrap"><table><thead><tr><th></th><th>Promotion</th><th>Status</th><th>Offer</th><th>Schedule</th><th>Coverage</th><th></th></tr></thead><tbody><tr t-foreach="state.promotions" t-as="promo" t-key="promo.id" class="dns-row-open" t-on-click="() => this.openPromotion(promo.id)"><td t-on-click.stop="() => {}"><input t-if="isManager" type="checkbox" t-att-checked="state.selected.has(promo.id)" t-on-change="() => this.toggleSelection(promo.id)"/></td><td><b class="link" t-esc="promo.name"/><small>Priority <t t-esc="promo.priority"/></small></td><td><span t-att-class="'dns-badge '+promo.state" t-esc="stateLabel(promo.state)"/></td><td t-esc="offerLabel(promo.offer_type)"/><td><t t-esc="promo.date_start"/><small>to <t t-esc="promo.date_end"/></small></td><td><b><t t-esc="promo.product_count"/> SKUs</b><small><t t-esc="promo.warehouse_count"/> stores · <t t-esc="promo.store_count"/> tills</small></td><td class="dns-row-actions" t-on-click.stop="() => {}"><button t-if="promo.can_edit and promo.state !== 'archived'" t-on-click="() => this.editPromotionById(promo.id)"><i class="fa fa-pencil"/> Edit</button><button t-if="promo.can_edit and ['draft','conflict'].includes(promo.state)" class="dns-primary" t-on-click="() => this.validatePromotion(promo.id)">Validate</button></td></tr></tbody></table></div>
        <div class="dns-pagination"><button t-on-click="previousPage" t-att-disabled="!state.offset">← Previous</button><span><t t-esc="state.offset + 1"/>–<t t-esc="Math.min(state.offset + state.limit, state.total)"/> of <t t-esc="state.total"/></span><button t-on-click="nextPage" t-att-disabled="state.offset + state.limit >= state.total">Next →</button></div>
      </t>

      <t t-if="state.view === 'builder' and canBuild">
        <div class="dns-builder-head"><div><span t-esc="state.builder.id ? 'EDIT CAMPAIGN' : 'NEW CAMPAIGN'"/><h2 t-esc="state.builder.id ? 'Change anything. Push it live.' : 'Build once. Deploy at scale.'"/></div><div class="dns-coverage"><b t-esc="coverageStoreCount()"/><span>stores</span><em><t t-esc="coverageCount()"/> tills</em></div></div>
        <ol class="dns-steps"><li t-foreach="['Basics','Stores','Products','Reward','Schedule','Review']" t-as="label" t-key="label" t-att-class="state.builder.step === label_index + 1 ? 'active' : state.builder.step > label_index + 1 ? 'done' : ''"><button t-on-click="() => this.setStep(label_index + 1)"><b t-esc="label_index + 1"/><span t-esc="label"/></button></li></ol>
        <section class="dns-builder-card">
          <div t-if="state.builder.step === 1" class="dns-form"><h3>Campaign basics</h3><p>Name the promotion and choose how it behaves at checkout.</p><label class="wide">Promotion name<input t-model="state.builder.name" placeholder="e.g. Back to School Mix &amp; Match"/></label><label>Offer type<select t-model="state.builder.offer_type"><option t-foreach="builderOfferTypes()" t-as="offer" t-key="offer.value" t-att-value="offer.value" t-esc="offer.label"/></select></label><label>Priority<input type="number" t-model.number="state.builder.priority"/></label><label class="check" t-if="state.builder.offer_type !== 'coupon'"><input type="checkbox" t-model="state.builder.automatic"/> Apply automatically at POS</label><p t-else="" class="dns-form-note">A coupon only applies once the cashier enters its code, so it never runs automatically.</p></div>
          <div t-if="state.builder.step === 2" class="dns-form"><h3>Store coverage</h3><p t-if="isManager">Assign the campaign to the whole network, reusable store groups, or individual tills. A store runs several tills, so a store group is usually what you want.</p><p t-else="">Pick the tills this campaign runs on. Only your own stores are listed.</p><label t-if="isManager" class="dns-all"><input type="checkbox" t-model="state.builder.all_stores"/><b>ALL TILLS</b><span>Every POS configuration across all stores (<t t-esc="state.options.stores.length"/>)</span></label><div class="dns-picker"><div t-if="isManager"><h4>STORE GROUPS</h4><label t-foreach="state.options.store_groups" t-as="group" t-key="group.id"><input type="checkbox" t-att-checked="state.builder.store_group_ids.includes(group.id)" t-on-change="() => this.toggleStoreGroup(group.id)"/><span t-esc="group.name"/><small><t t-esc="group.warehouse_count"/> stores · <t t-esc="group.count"/> tills</small></label></div><div><h4>INDIVIDUAL TILLS</h4><t t-foreach="storesWithTills()" t-as="store" t-key="store.name"><label class="dns-store-head"><input type="checkbox" t-att-checked="storeIsFullySelected(store)" t-on-change="() => this.toggleStoreTills(store)"/><span t-esc="store.name"/><small><t t-esc="store.tills.length"/> tills</small></label><label t-foreach="store.tills" t-as="till" t-key="till.id" class="dns-till-row"><input type="checkbox" t-att-checked="state.builder.pos_config_ids.includes(till.id)" t-on-change="() => this.toggleStore(till.id)"/><span t-esc="till.name"/></label></t></div></div></div>
          <div t-if="state.builder.step === 3" class="dns-form"><h3>Product segment</h3><p>Paste up to 10,000 SKU/barcodes or combine catalogue filters. No product tags are created.</p><label class="dns-all"><input type="checkbox" t-model="state.builder.selector.all_products"/><b>ALL POS PRODUCTS</b><span>Use for order-wide offers</span></label><label class="wide">Paste SKU or barcode list<textarea t-model="state.builder.selector.barcode_terms" rows="8" placeholder="One value per line, or paste a column from Excel&#10;9312345678901&#10;SKU-004581&#10;9312345678925"/></label><div t-if="state.builder.selector.products.length" class="dns-existing-products wide"><h4>PRODUCTS IN THIS PROMOTION <small><t t-esc="state.builder.selector.products.length"/></small></h4><div class="dns-existing-list"><div t-foreach="state.builder.selector.products" t-as="product" t-key="product.id"><span t-esc="product.sku"/><span t-esc="product.barcode"/><b t-esc="product.name"/><button title="Remove from this promotion" t-on-click="() => this.removeBuilderProduct(product.id)">✕</button></div></div></div><div t-if="state.builder.manual_products.length" class="dns-existing-products wide"><h4>ADDED INDIVIDUALLY <small><t t-esc="state.builder.manual_products.length"/></small></h4><p>Kept as they are. Remove these from the promotion's product list.</p><div class="dns-existing-list"><div t-foreach="state.builder.manual_products" t-as="product" t-key="product.id"><span t-esc="product.sku"/><span t-esc="product.barcode"/><b t-esc="product.name"/></div></div></div><div class="dns-filter-grid"><label>Categories<select multiple="multiple" t-on-change="(ev) => this.setMulti(ev, 'category_ids')"><option t-foreach="state.options.categories" t-as="item" t-key="item.id" t-att-value="item.id" t-att-selected="state.builder.selector.category_ids.includes(item.id)" t-esc="item.name"/></select></label><label>Tags<select multiple="multiple" t-on-change="(ev) => this.setMulti(ev, 'tag_ids')"><option t-foreach="state.options.tags" t-as="item" t-key="item.id" t-att-value="item.id" t-att-selected="state.builder.selector.tag_ids.includes(item.id)" t-esc="item.name"/></select></label><label>Vendors<select multiple="multiple" t-on-change="(ev) => this.setMulti(ev, 'vendor_ids')"><option t-foreach="state.options.vendors" t-as="item" t-key="item.id" t-att-value="item.id" t-att-selected="state.builder.selector.vendor_ids.includes(item.id)" t-esc="item.name"/></select></label></div><button class="dns-secondary" t-on-click="previewProducts" t-att-disabled="state.previewLoading"><i class="fa fa-eye"/> Preview resolved products</button><div t-if="state.preview" class="dns-preview"><div><b t-esc="state.preview.count"/><span>eligible products</span></div><div><b t-esc="state.preview.unmatched.length"/><span>unmatched values</span></div><table><tr t-foreach="state.preview.sample.slice(0,10)" t-as="product" t-key="product.id"><td t-esc="product.sku"/><td t-esc="product.barcode"/><td t-esc="product.name"/></tr></table><small t-if="state.preview.truncated">Showing 10 samples only. The complete set is resolved during validation.</small></div></div>
          <div t-if="state.builder.step === 4" class="dns-form"><h3>Reward</h3><p>All calculations use the current base sale price—never a promotional pricelist.</p><label t-if="['product_percent','order_percent','coupon'].includes(state.builder.offer_type)">Discount %<input type="number" min="0" max="100" t-model.number="state.builder.percent_discount"/></label><label t-if="['product_fixed','order_fixed','coupon'].includes(state.builder.offer_type)">Fixed discount<input type="number" min="0" step="0.01" t-model.number="state.builder.fixed_discount"/></label><label t-if="['single_bundle','mix_match','multi_group','buy_x_get_y'].includes(state.builder.offer_type)"><t t-esc="state.builder.offer_type === 'buy_x_get_y' ? 'Buy quantity (X)' : 'Required quantity'"/><input type="number" min="1" t-model.number="state.builder.required_qty"/></label><label t-if="['single_bundle','mix_match','multi_group'].includes(state.builder.offer_type)">Bundle total<input type="number" min="0" step="0.01" t-model.number="state.builder.bundle_total"/></label><label t-if="state.builder.offer_type === 'buy_x_get_y'">Free quantity (Y)<input type="number" min="1" t-model.number="state.builder.reward_qty"/></label>
            <div t-if="state.builder.offer_type === 'buy_x_get_y'" class="dns-reward-picker wide">
              <b>Free product</b>
              <div t-if="state.builder.reward_product_id" class="dns-reward-chosen"><span t-esc="state.builder.reward_product_name"/><button t-on-click="clearRewardProduct">CHANGE</button></div>
              <t t-else="">
                <div class="dns-reward-search"><input t-model="state.rewardSearch.query" t-on-keydown="onRewardSearchKeydown" placeholder="Search the giveaway product by name, SKU or barcode"/><button class="dns-secondary" t-on-click="searchRewardProducts" t-att-disabled="state.rewardSearch.loading">SEARCH</button></div>
                <div t-if="state.rewardSearch.loading" class="dns-loading">Searching…</div>
                <button class="dns-reward-hit" t-foreach="state.rewardSearch.results" t-as="product" t-key="product.id" t-on-click="() => this.pickRewardProduct(product)"><b t-esc="product.name"/><small><t t-esc="product.sku || '—'"/> · <t t-esc="product.barcode || 'no barcode'"/> · <t t-esc="product.price"/></small></button>
                <p t-if="!state.rewardSearch.loading and !state.rewardSearch.results.length" class="dns-reward-hint">Required — the promotion cannot be validated without a free product.</p>
              </t>
            </div>
            <label t-if="state.builder.offer_type === 'coupon'" class="wide">Coupon code<input t-model="state.builder.coupon_code" placeholder="e.g. WINTER10 - codes are never reused, even after the promotion ends"/><small t-if="state.builder.percent_discount and state.builder.fixed_discount">Both a percentage and an amount are set; the percentage wins at the till.</small></label><label t-if="['order_percent','order_fixed','coupon'].includes(state.builder.offer_type)">Minimum order value<input type="number" min="0" step="0.01" t-model.number="state.builder.minimum_order_amount"/></label></div>
          <div t-if="state.builder.step === 5" class="dns-form"><h3>Schedule</h3><p>Times are wall-clock in the timezone selected below — pick the store's zone, not your own. They are converted to UTC for storage, and the POS also expires cached offers locally.</p><label>Starts<input type="datetime-local" t-model="state.builder.date_start"/></label><label>Ends<input type="datetime-local" t-model="state.builder.date_end"/></label><label>Timezone<select t-model="state.builder.timezone"><option t-foreach="state.options.timezones" t-as="tz" t-key="tz" t-att-value="tz" t-esc="tz"/></select></label></div>
          <div t-if="state.builder.step === 6" class="dns-review"><h3>Ready for validation</h3><div><span>Campaign</span><b t-esc="state.builder.name || 'Not named'"/></div><div><span>Offer</span><b t-esc="offerLabel(state.builder.offer_type)"/></div><div><span>Store coverage</span><b><t t-esc="coverageCount()"/> stores</b></div><div><span>Products</span><b t-esc="state.preview ? state.preview.count + ' previewed' : 'Resolved at validation'"/></div><div><span>Schedule</span><b><t t-esc="state.builder.date_start || 'Not set'"/> → <t t-esc="state.builder.date_end || 'Not set'"/> (<t t-esc="state.builder.timezone"/>)</b></div><aside t-if="!builderProblems().length"><i class="fa fa-shield"/><p>Server validation materializes product membership and blocks overlapping store, product and date scopes.</p></aside><aside t-else="" class="dns-review-problems"><i class="fa fa-exclamation-triangle"/><div><b>Not ready to save yet</b><ul><li t-foreach="builderProblems()" t-as="problem" t-key="problem" t-esc="problem"/></ul></div></aside></div>
          <footer><button t-if="state.builder.step > 1" t-on-click="previousStep">← Back</button><span/><button t-if="state.builder.step &lt; 6" class="dns-primary" t-on-click="nextStep">Continue →</button><button t-if="state.builder.step === 6" t-on-click="saveDraft" t-att-disabled="state.saving or builderProblems().length">Save draft</button><button t-if="state.builder.step === 6" class="dns-primary" t-on-click="launchPromotion" t-att-disabled="state.saving or builderProblems().length" t-esc="state.builder.id ? 'Save &amp; revalidate' : 'Validate &amp; launch'"/></footer>
        </section>
      </t>

      <t t-if="state.view === 'products'"><section class="dns-page-head"><div><h2>Product Explorer</h2><p>Scan a primary or alternate barcode to find current and historic campaigns.</p></div><button class="dns-primary" t-on-click="searchProducts">SEARCH</button></section><div class="dns-product-card" t-foreach="state.products" t-as="product" t-key="product.id"><div><span>PRODUCT</span><h3 t-esc="product.name"/><p><b>Barcode</b> <t t-esc="product.barcode || '—'"/></p><p><b>Aliases</b> <t t-esc="product.alternate_barcodes.join(', ') || '—'"/></p></div><div><h4>PROMOTION HISTORY</h4><button t-foreach="product.promotions" t-as="promo" t-key="promo.id" t-on-click="() => this.openPromotion(promo.id)"><span t-att-class="'dns-badge '+promo.state" t-esc="stateLabel(promo.state)"/><t t-esc="promo.name"/></button><p t-if="!product.promotions.length">No promotion history.</p></div></div><div t-if="!state.products.length" class="dns-empty">Enter or scan a barcode in the search bar.</div></t>
      <t t-if="state.view === 'conflicts'"><section class="dns-page-head"><div><h2>Conflict Queue</h2><p><t t-esc="state.conflictTotal"/> overlapping product/store/date combinations require action.</p></div></section><div class="dns-table-wrap"><table><thead><tr><th>Proposed</th><th>Conflicts with</th><th>Product / Barcode</th><th>Store</th><th>Overlap</th></tr></thead><tbody><tr t-foreach="state.conflicts" t-as="item" t-key="item.id"><td><button class="link" t-on-click="() => this.openPromotion(item.promotion_id)" t-esc="item.promotion"/></td><td t-esc="item.existing"/><td><b t-esc="item.product"/><small t-esc="item.barcode"/></td><td t-esc="item.store"/><td><t t-esc="item.start"/> → <t t-esc="item.end"/></td></tr></tbody></table></div></t>
      <t t-if="state.view === 'detail' and state.detail">
        <section class="dns-detail-hero"><div><button class="dns-back" t-on-click="() => this.navigate('promotions')">← Promotion library</button><span t-att-class="'dns-badge '+state.detail.state" t-esc="stateLabel(state.detail.state)"/><h2 t-esc="state.detail.name"/><p><t t-esc="state.detail.offer_label"/> · Version <t t-esc="state.detail.version"/> · Priority <t t-esc="state.detail.priority"/></p></div><div><button t-if="state.detail.can_edit and state.detail.state !== 'archived'" t-on-click="editPromotion"><i class="fa fa-pencil"/> EDIT</button><button t-if="state.detail.can_edit" t-on-click="clonePromotion"><i class="fa fa-copy"/> CLONE</button><button t-if="state.detail.can_edit and ['draft','conflict'].includes(state.detail.state)" class="dns-primary" t-on-click="() => this.validatePromotion(state.detail.id)">VALIDATE</button></div></section>
        <section class="dns-detail-metrics">
          <article class="dns-tile-action" role="button" tabindex="0" t-att-aria-expanded="state.productPanel.open ? 'true' : 'false'"
                   t-on-click="toggleDetailProducts" t-on-keydown="(ev) => ['Enter',' '].includes(ev.key) &amp;&amp; this.toggleDetailProducts()">
            <span>PRODUCTS</span><b t-esc="state.detail.product_count"/>
            <em class="dns-tile-hint"><t t-esc="state.productPanel.open ? 'HIDE LIST' : 'VIEW LIST'"/> →</em>
          </article>
          <article><span>STORES</span><b t-esc="state.detail.warehouse_count"/><em class="dns-tile-hint"><t t-esc="state.detail.store_count"/> TILLS</em></article>
          <article><span>CONFLICTS</span><b t-esc="state.detail.conflict_count"/></article>
          <article><span>SCHEDULE</span><b class="small"><t t-esc="state.detail.date_start"/><br/>→ <t t-esc="state.detail.date_end"/><br/><em t-esc="state.detail.timezone"/></b></article>
        </section>

        <section t-if="state.productPanel.open" class="dns-panel dns-product-panel">
          <header>
            <h3>PRODUCTS IN THIS PROMOTION</h3>
            <button t-on-click="toggleDetailProducts">CLOSE ✕</button>
          </header>
          <div class="dns-product-filter">
            <label><i class="fa fa-search"/><input t-model="state.productPanel.query" t-on-keydown="onProductPanelKeydown" placeholder="Filter by product, SKU or barcode"/></label>
            <button class="dns-primary" t-on-click="() => this.loadDetailProducts(0)">SEARCH</button>
          </div>
          <div t-if="state.detail.can_edit and state.detail.state !== 'archived'" class="dns-product-add">
            <label>Add products<textarea t-model="state.productPanel.addTerms" rows="2" placeholder="Scan or paste SKU/barcode values, one per line"/></label>
            <button class="dns-secondary" t-on-click="addProducts" t-att-disabled="state.productPanel.busy or !state.productPanel.addTerms.trim()"><i class="fa fa-plus"/> ADD</button>
            <small t-if="state.detail.excluded_count"><t t-esc="state.detail.excluded_count"/> product(s) currently excluded from this promotion.</small>
          </div>
          <div t-if="state.productPanel.loading" class="dns-loading"><i class="fa fa-circle-o-notch fa-spin"/> Loading products…</div>
          <t t-else="">
            <div class="dns-table-wrap">
              <table>
                <thead><tr><th>SKU</th><th>Barcode</th><th>Product</th><th>Price</th><th>Selector</th><th></th></tr></thead>
                <tbody>
                  <tr t-foreach="state.productPanel.records" t-as="row" t-key="row.id">
                    <td t-esc="row.sku || '—'"/>
                    <td t-esc="row.barcode || '—'"/>
                    <td t-esc="row.name"/>
                    <td t-esc="row.price"/>
                    <td t-esc="row.group || row.selector || '—'"/>
                    <td><button t-if="state.detail.can_edit and state.detail.state !== 'archived'" class="dns-row-remove" title="Remove from this promotion" t-att-disabled="state.productPanel.busy" t-on-click="() => this.removeProduct(row.product_id)">✕</button></td>
                  </tr>
                  <tr t-if="!state.productPanel.records.length"><td colspan="6" class="dns-empty">No products match this filter.</td></tr>
                </tbody>
              </table>
            </div>
            <div t-if="state.productPanel.total" class="dns-pagination">
              <button t-on-click="previousProductPage" t-att-disabled="!state.productPanel.offset">← Previous</button>
              <span><t t-esc="state.productPanel.offset + 1"/>–<t t-esc="Math.min(state.productPanel.offset + state.productPanel.limit, state.productPanel.total)"/> of <t t-esc="state.productPanel.total"/></span>
              <button t-on-click="nextProductPage" t-att-disabled="state.productPanel.offset + state.productPanel.limit >= state.productPanel.total">Next →</button>
            </div>
          </t>
        </section>
        <section class="dns-detail-grid"><article class="dns-panel"><header><h3>OFFER CONFIGURATION</h3></header><dl><dt>Offer</dt><dd t-esc="state.detail.offer_label"/><dt>Reward</dt><dd t-esc="rewardSummary(state.detail)"/><t t-if="state.detail.coupon_code"><dt>Coupon code</dt><dd t-esc="state.detail.coupon_code"/></t><dt>Applies</dt><dd t-esc="state.detail.automatic ? 'Automatically at the till' : 'Only when the cashier enters it'"/><t t-if="state.detail.minimum_order_amount"><dt>Minimum order</dt><dd>$<t t-esc="state.detail.minimum_order_amount"/></dd></t><dt>Products</dt><dd t-esc="state.detail.all_products ? 'Every POS product' : state.detail.product_count + ' SKUs'"/><dt>Priority</dt><dd t-esc="state.detail.priority"/><dt>Runs</dt><dd><t t-esc="state.detail.date_start"/> → <t t-esc="state.detail.date_end"/></dd><dt>Timezone</dt><dd t-esc="state.detail.timezone"/><t t-if="isManager"><dt>Store groups</dt><dd t-esc="state.detail.store_groups.join(', ') || 'Individual/all stores'"/></t></dl><header><h3>PRODUCT SELECTORS</h3></header><div class="dns-selector-row" t-foreach="state.detail.selectors" t-as="selector" t-key="selector.id"><div><b t-esc="selector.name"/><small t-if="selector.group">Group: <t t-esc="selector.group"/></small><small t-if="selector.all_products">All POS products</small><small t-if="selector.product_list_count"><t t-esc="selector.product_list_count"/> listed products</small><small t-if="selector.barcode_count"><t t-esc="selector.barcode_count"/> pasted SKU/barcodes</small><small t-if="selector.categories.length">Categories: <t t-esc="selector.categories.join(', ')"/></small><small t-if="selector.tags.length">Tags: <t t-esc="selector.tags.join(', ')"/></small><small t-if="selector.vendors.length">Vendors: <t t-esc="selector.vendors.join(', ')"/></small></div><strong><t t-esc="selector.resolved_count"/> SKUs</strong></div><t t-if="state.detail.assortment_groups.length"><header><h3>ASSORTMENT GROUPS</h3></header><div class="dns-selector-row" t-foreach="state.detail.assortment_groups" t-as="group" t-key="group.id"><b t-esc="group.name"/><strong>Needs <t t-esc="group.required_qty"/></strong></div></t><t t-if="state.detail.excluded_products.length"><header><h3>EXCLUDED PRODUCTS</h3></header><div class="dns-selector-row" t-foreach="state.detail.excluded_products" t-as="product" t-key="product.id"><div><b t-esc="product.name"/><small><t t-esc="product.sku"/> <t t-esc="product.barcode"/></small></div></div></t><header><h3>STORES &amp; TILLS</h3></header><div t-if="state.detail.all_stores" class="dns-selector-row"><b>All stores</b></div><div class="dns-selector-row" t-foreach="state.detail.store_tills" t-as="store" t-key="store.store"><div><b t-esc="store.store"/><small t-esc="store.tills.join(', ')"/></div><strong><t t-esc="store.tills.length"/> tills</strong></div></article><article class="dns-panel dns-timeline"><header><h3>PROMOTION TIMELINE</h3></header><div t-foreach="state.detail.audits" t-as="audit" t-key="audit.id"><i/><section><b t-esc="audit.event.replaceAll('_',' ')"/><p t-esc="audit.message"/><small><t t-esc="audit.user"/> · <t t-esc="audit.date"/></small></section></div></article></section>
      </t>
      <t t-if="state.view === 'stores' and isManager">
        <section class="dns-page-head"><div><h2>Store Groups</h2><p>Reusable coverage for regions, formats and campaign waves.</p></div><button class="dns-primary" t-on-click="() => this.editStoreGroup()">+ NEW STORE GROUP</button></section>
        <section class="dns-management-grid"><div class="dns-group-list"><article t-foreach="state.storeGroups" t-as="group" t-key="group.id"><header><div><h3 t-esc="group.name"/><span><t t-esc="group.warehouse_count"/> stores · <t t-esc="group.store_count"/> tills · <t t-esc="group.promotion_count"/> promotions</span></div><button t-on-click="() => this.editStoreGroup(group)">EDIT</button></header><p t-esc="group.stores.slice(0,12).join(' · ')"/><small t-if="group.stores.length > 12">+ <t t-esc="group.stores.length - 12"/> more stores</small></article></div><aside class="dns-group-editor"><span>GROUP EDITOR</span><h3 t-esc="state.groupEditor.id ? 'Edit store group' : 'Create store group'"/><label>Group name<input t-model="state.groupEditor.name" placeholder="e.g. Queensland Metro"/></label><div><t t-foreach="storesWithTills()" t-as="store" t-key="store.name"><label class="dns-store-head"><input type="checkbox" t-att-checked="groupEditorStoreSelected(store)" t-on-change="() => this.toggleGroupEditorStoreTills(store)"/><span t-esc="store.name"/><small><t t-esc="store.tills.length"/> tills</small></label><label t-foreach="store.tills" t-as="till" t-key="till.id" class="dns-till-row"><input type="checkbox" t-att-checked="state.groupEditor.pos_config_ids.includes(till.id)" t-on-change="() => this.toggleGroupEditorStore(till.id)"/><span t-esc="till.name"/></label></t></div><button class="dns-primary" t-on-click="saveStoreGroup" t-att-disabled="state.saving or !state.groupEditor.name.trim() or !state.groupEditor.pos_config_ids.length">SAVE GROUP</button></aside></section>
      </t>
      <t t-if="state.view === 'selectors'">
        <section class="dns-page-head"><div><h2>Product Selector Groups</h2><p>Understand catalogue logic without rendering thousands of product tags.</p></div><button t-if="canBuild" class="dns-primary" t-on-click="startBuilder">+ BUILD SELECTOR</button></section>
        <section class="dns-selector-cards"><article t-foreach="state.selectors" t-as="selector" t-key="selector.id"><header><span t-att-class="'dns-badge '+selector.state" t-esc="stateLabel(selector.state)"/><button t-on-click="() => this.openPromotion(selector.promotion_id)" t-esc="selector.name"/></header><h3><t t-esc="selector.resolved_count"/> <small>resolved SKUs</small></h3><p><b>Used by:</b> <t t-esc="selector.promotion"/></p><div><span t-if="selector.all_products">All products</span><span t-if="selector.barcode_count"><t t-esc="selector.barcode_count"/> pasted codes</span><span t-foreach="selector.categories.slice(0,3)" t-as="category" t-key="category" t-esc="category"/><span t-foreach="selector.tags.slice(0,3)" t-as="tag" t-key="tag" t-esc="tag"/></div></article><div t-if="!state.selectors.length" class="dns-empty">No selector groups match this search.</div></section>
      </t>
    </div>
  </section>
</main>
</t>
</templates>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dns_legacy_migration_form" model="ir.ui.view">
        <field name="name">dns.legacy.promotion.migration.form</field>
        <field name="model">dns.legacy.promotion.migration</field>
        <field name="arch" type="xml">
            <form string="Migrate Legacy Promotions">
                <group><field name="dry_run"/><field name="migrate_inactive"/></group>
                <field name="result" nolabel="1" readonly="1" widget="text"/>
                <footer><button name="action_migrate" string="Run Migration" type="object" class="btn-primary"/><button string="Close" special="cancel"/></footer>
            </form>
        </field>
    </record>
    <record id="action_dns_legacy_migration" model="ir.actions.act_window"><field name="name">Migrate Legacy Promotions</field><field name="res_model">dns.legacy.promotion.migration</field><field name="view_mode">form</field><field name="target">new</field></record>
    <menuitem id="menu_dns_legacy_migration" name="Migrate Legacy Promotions" parent="dns_pos_promotions.menu_dns_promotions_root" action="action_dns_legacy_migration" sequence="90" groups="dns_pos_promotions.group_dns_promotion_manager"/>

    <record id="view_dns_product_csv_form" model="ir.ui.view">
        <field name="name">dns.promotion.product.csv.form</field><field name="model">dns.promotion.product.csv</field>
        <field name="arch" type="xml"><form string="Import Promotion Products"><group><field name="promotion_id"/><field name="file" filename="filename"/><field name="filename" invisible="1"/></group><field name="result" readonly="1" nolabel="1"/><footer><button name="action_import" string="Import" type="object" class="btn-primary"/><button string="Close" special="cancel"/></footer></form></field>
    </record>
</odoo>

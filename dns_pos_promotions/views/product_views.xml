<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Template Inherit View -->
    <record id="product_template_form_view_dns_promotion_inherit" model="ir.ui.view">
        <field name="name">product.template.form.dns.promotion.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="vendor_id"/>
                <field name="product_season"/>
                <field name="product_subcategory"/>
                <field name="product_tag_ids" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Multi Barcodes" name="multi_barcodes">
                    <field name="multi_barcode_ids">
                        <tree editable="bottom">
                            <field name="multi_barcode"/>
                            <field name="name"/>
                            <field name="product_id"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Products Seasons Action & Views -->
    <record id="action_products_seasons" model="ir.actions.act_window">
        <field name="name">Product Seasons</field>
        <field name="res_model">products.seasons</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_products_seasons_tree" model="ir.ui.view">
        <field name="name">products.seasons.tree</field>
        <field name="model">products.seasons</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Products Subcategory / Size Action & Views -->
    <record id="action_products_subcategory" model="ir.actions.act_window">
        <field name="name">Product Subcategories / Sizes</field>
        <field name="res_model">products.subcategory</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_products_subcategory_tree" model="ir.ui.view">
        <field name="name">products.subcategory.tree</field>
        <field name="model">products.subcategory</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
</odoo>

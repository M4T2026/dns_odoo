<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_dns_promotion_workspace" model="ir.actions.client">
        <field name="name">Promotion Workspace</field>
        <field name="tag">dns_pos_promotions.workspace</field>
    </record>
    <record id="action_dns_promotion_webapp" model="ir.actions.act_url">
        <field name="name">Odoo Promotions</field>
        <field name="url">/dns/promotions</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_dns_promotions_root" name="Odoo Promotions" action="action_dns_promotion_webapp" sequence="35" groups="dns_pos_promotions.group_dns_promotion_user"/>
    <record id="menu_dns_promotions_root" model="ir.ui.menu">
        <field name="parent_id" eval="False"/>
        <field name="web_icon">dns_pos_promotions,static/description/icon.png</field>
    </record>
    <menuitem id="menu_dns_promotion_workspace" name="Open Promotion Webapp" parent="menu_dns_promotions_root" action="action_dns_promotion_webapp" sequence="1"/>
    <!-- Managers only: the report spans every store, and viewers are limited to their Allowed POS. -->
    <menuitem id="menu_dns_promotion_analysis" name="Analysis" parent="menu_dns_promotions_root"
              action="action_dns_promotion_report" sequence="5"
              groups="dns_pos_promotions.group_dns_promotion_manager"/>
    <!-- Retain historical XML IDs as inactive records. Some client menu overrides
         are not safe during module-upgrade unlink outside an HTTP request. -->
    <record id="menu_dns_promotion_records" model="ir.ui.menu">
        <field name="name">Promotion Records (Technical)</field>
        <field name="parent_id" ref="menu_dns_promotions_root"/>
        <field name="action" ref="action_dns_pos_promotion"/>
        <field name="active" eval="False"/>
    </record>
    <record id="menu_dns_store_groups" model="ir.ui.menu">
        <field name="name">Store Groups (Technical)</field>
        <field name="parent_id" ref="menu_dns_promotions_root"/>
        <field name="action" ref="action_dns_store_group"/>
        <field name="active" eval="False"/>
    </record>
</odoo>

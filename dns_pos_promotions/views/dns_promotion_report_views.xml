<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dns_promotion_report_pivot" model="ir.ui.view">
        <field name="name">dns.promotion.report.pivot</field>
        <field name="model">dns.promotion.report</field>
        <field name="arch" type="xml">
            <!-- Opens promotion-wise; product and store are one drag away, or one click in the
                 Group By menu. -->
            <pivot string="Promotion Analysis" sample="1">
                <field name="promotion_name" type="row"/>
                <field name="saved_amount" type="measure"/>
                <field name="net_amount" type="measure"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_dns_promotion_report_graph" model="ir.ui.view">
        <field name="name">dns.promotion.report.graph</field>
        <field name="model">dns.promotion.report</field>
        <field name="arch" type="xml">
            <graph string="Promotion Analysis" type="bar" sample="1">
                <field name="promotion_name"/>
                <field name="saved_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_dns_promotion_report_tree" model="ir.ui.view">
        <field name="name">dns.promotion.report.tree</field>
        <field name="model">dns.promotion.report</field>
        <field name="arch" type="xml">
            <!-- A SQL view cannot be written to, so the row actions are all off. -->
            <tree string="Promotion Analysis" create="false" edit="false" delete="false" sample="1">
                <field name="date"/>
                <field name="promotion_name"/>
                <field name="offer_type" optional="show"/>
                <field name="rule" optional="hide"/>
                <field name="product_id"/>
                <field name="categ_id" optional="hide"/>
                <field name="warehouse_id"/>
                <field name="config_id" optional="show"/>
                <field name="order_id" optional="hide"/>
                <field name="quantity" sum="Quantity"/>
                <field name="base_amount" sum="Before Discount" optional="show"/>
                <field name="saved_amount" sum="Customer Saved"/>
                <field name="net_amount" sum="Net Sold"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_dns_promotion_report_search" model="ir.ui.view">
        <field name="name">dns.promotion.report.search</field>
        <field name="model">dns.promotion.report</field>
        <field name="arch" type="xml">
            <search string="Promotion Analysis">
                <field name="promotion_name" string="Promotion"/>
                <field name="product_id"/>
                <field name="warehouse_id" string="Store"/>
                <field name="config_id" string="Till"/>
                <field name="categ_id"/>
                <field name="order_id"/>
                <filter name="this_month" string="This Month"
                        domain="[('date','&gt;=',(context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="this_year" string="This Year"
                        domain="[('date','&gt;=',(context_today().replace(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="saved_something" string="Discounted" domain="[('saved_amount','!=',0)]"/>
                <group expand="1" string="Group By">
                    <!-- The three cuts this report exists for, first and explicit. -->
                    <filter name="group_by_promotion" string="Promotion" context="{'group_by':'promotion_name'}"/>
                    <filter name="group_by_product" string="Product" context="{'group_by':'product_id'}"/>
                    <filter name="group_by_store" string="Store" context="{'group_by':'warehouse_id'}"/>
                    <separator/>
                    <filter name="group_by_till" string="Till" context="{'group_by':'config_id'}"/>
                    <filter name="group_by_categ" string="Product Category" context="{'group_by':'categ_id'}"/>
                    <filter name="group_by_offer_type" string="Offer Type" context="{'group_by':'offer_type'}"/>
                    <filter name="group_by_rule" string="Applied Rule" context="{'group_by':'rule'}"/>
                    <filter name="group_by_session" string="Session" context="{'group_by':'session_id'}"/>
                    <filter name="group_by_date" string="Order Date" context="{'group_by':'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dns_promotion_report" model="ir.actions.act_window">
        <field name="name">Promotion Analysis</field>
        <field name="res_model">dns.promotion.report</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="search_view_id" ref="view_dns_promotion_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No promotion has been redeemed yet</p>
            <p>
                Every till sale priced by a promotion lands here. Group by Promotion, Product or
Store to see where the discount actually went.
                A store is the warehouse behind the tills, so its several POS configs roll up together.
            </p>
        </field>
    </record>
</odoo>
